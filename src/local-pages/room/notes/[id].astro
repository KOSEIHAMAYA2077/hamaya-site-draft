---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Toc from '../../../components/Toc.astro';
import { formatDate } from '../../../lib/content';
import { path } from '../../../lib/paths';
import { workroomNotes } from '../../../lib/workroom-notes.mjs';
export async function getStaticPaths() {
  return workroomNotes(await getCollection('notes')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  section="notes"
  type="article"
  canonical={false}
>
  <article class="shell article-page" data-return-note-id={entry.id}>
    <a class="back-link" href={path('room/notes/')} data-note-back>
      ← 記録の一覧へ
    </a>
    <p class="local-record-status">
      <strong>下書き・本人確認待ち</strong>
      <span>ローカル閲覧</span>
    </p>
    <header class="article-heading">
      <p class="eyebrow">NOTE / {entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      <ul class="tags" aria-label="タグ">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </header>
    <Toc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <a class="back-link bottom-back" href={path('room/notes/')} data-note-back>
      ← 記録の一覧へ
    </a>
  </article>
</Layout>

<script>
  import { workroomNotesListHref } from '../../../lib/workroom-note-query.mjs';

  function restoreBackLinks() {
    const href = workroomNotesListHref(
      window.location.search,
      import.meta.env.BASE_URL,
    );
    document
      .querySelectorAll<HTMLAnchorElement>('[data-note-back]')
      .forEach((link) => {
        link.href = href;
      });
  }
  restoreBackLinks();
  window.addEventListener('popstate', restoreBackLinks);
  window.addEventListener('pageshow', restoreBackLinks);
</script>

<style>
  .local-record-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 11px;
  }
  .local-record-status strong {
    font-weight: 500;
    color: var(--ink);
  }
</style>
