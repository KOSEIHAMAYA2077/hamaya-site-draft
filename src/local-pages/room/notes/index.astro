---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SimpleNotes from '../../../components/SimpleNotes.astro';
import { workroomNotes } from '../../../lib/workroom-notes.mjs';
const notes = workroomNotes(await getCollection('notes'));
---

<Layout
  title="雑記"
  description="ゲームや日々の感想。"
  section="notes"
  canonical={false}
>
  <SimpleNotes notes={notes} local />
</Layout>
