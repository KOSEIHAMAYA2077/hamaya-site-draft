---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import WorkroomNoteRow from '../../../components/WorkroomNoteRow.astro';
import { path } from '../../../lib/paths';
import { NOTE_QUERY_LIMIT } from '../../../lib/note-query.mjs';
import { workroomNotes } from '../../../lib/workroom-notes.mjs';
const notes = workroomNotes(await getCollection('notes'));
---

<Layout
  title="記録を読む"
  description="以前の記録を読み返す、ローカル閲覧用の一覧。"
  section="notes"
  canonical={false}
>
  <div class="shell inner-page">
    <header class="page-heading">
      <p class="eyebrow">NOTES / ローカル閲覧</p>
      <h1>記録を読む</h1>
      <p>
        以前の記録を、原文のまま置いています。
        <br />
        <strong>下書き・本人確認待ち</strong>
      </p>
      <a class="write-record" href={path('write/?kind=note')}>
        新しい記録を書く <span aria-hidden="true">→</span>
      </a>
    </header>
    <div class="notes-tools" data-note-tools hidden>
      <div class="filter-group" role="group" aria-label="記事の種類">
        <button type="button" data-filter="all" aria-pressed="true">
          すべて
        </button>
        <button type="button" data-filter="学び" aria-pressed="false">
          学び
        </button>
        <button type="button" data-filter="雑記" aria-pressed="false">
          雑記
        </button>
      </div>
      <div class="search-field">
        <label for="note-search">記録を探す</label>
        <input
          id="note-search"
          type="search"
          placeholder="タイトル・要約・タグ"
          maxlength={NOTE_QUERY_LIMIT}
        />
      </div>
      <button
        type="button"
        class="reset-button clear-query"
        data-reset
        data-clear-query
        hidden
      >
        すべての記録を表示
      </button>
    </div>
    <p
      class="results-count"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-count
    >
      {notes.length}件の記録
    </p>
    {notes.length ? (
      <>
        <div class="entry-list">
          {notes.map((entry) => (
            <WorkroomNoteRow entry={entry} />
          ))}
        </div>
        <div class="no-results" data-no-results hidden>
          <h2>一致する記録がありません。</h2>
          <p>別の言葉で探すか、種類を「すべて」に戻してみてください。</p>
          <button type="button" class="reset-button" data-reset>
            すべての記録を表示
          </button>
        </div>
      </>
    ) : (
      <div class="no-results">
        <h2>読む記録がまだありません。</h2>
        <p>この一覧には、ローカルでの閲覧用に選んだ記録が入ります。</p>
        <a class="back-link" href={path()}>
          ← ホームへ戻る
        </a>
      </div>
    )}
    <details class="local-record-scope">
      <summary>この一覧に入る記録</summary>
      <p>
        以前のサイトから引き継いだ1件を対象にしています。
        新しく書いた下書きや書き方のサンプルは、自動では追加されません。
      </p>
      <p>ここで読んでも、記事の公開設定は変わりません。</p>
    </details>
  </div>
</Layout>

<script>
  import {
    normalizeNoteQuery,
    noteQueryString,
    readNoteQuery,
    withNoteQuery,
  } from '../../../lib/note-query.mjs';

  const tools = document.querySelector<HTMLElement>('[data-note-tools]');
  const search = document.querySelector<HTMLInputElement>('#note-search');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
  ];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const clearQuery = document.querySelector<HTMLElement>('[data-clear-query]');
  const links = entries.flatMap((entry) => {
    const link = entry.querySelector<HTMLAnchorElement>('a');
    return link ? [{ link, pathname: link.pathname }] : [];
  });
  let conditions = readNoteQuery(window.location.search);
  let appliedQuery: string | undefined;
  let composing = false;

  function update() {
    const nextQuery = noteQueryString(conditions);
    if (appliedQuery === nextQuery) return;
    appliedQuery = nextQuery;
    const query = conditions.q.toLocaleLowerCase('ja');
    let visible = 0;
    entries.forEach((entry) => {
      const hidden =
        !(
          conditions.category === 'all' ||
          entry.dataset.category === conditions.category
        ) || !(entry.dataset.search || '').includes(query);
      if (entry.hidden !== hidden) entry.hidden = hidden;
      if (!entry.hidden) visible += 1;
    });
    filters.forEach((button) => {
      const pressed = String(button.dataset.filter === conditions.category);
      if (button.getAttribute('aria-pressed') !== pressed)
        button.setAttribute('aria-pressed', pressed);
    });
    const countText = `${visible}件の記録`;
    if (count && count.textContent !== countText) count.textContent = countText;
    if (noResults && noResults.hidden !== visible > 0)
      noResults.hidden = visible > 0;
    const cleared = !conditions.q && conditions.category === 'all';
    if (clearQuery && clearQuery.hidden !== cleared)
      clearQuery.hidden = cleared;
    links.forEach(({ link, pathname }) => {
      const href = withNoteQuery(pathname, conditions);
      if (link.getAttribute('href') !== href) link.setAttribute('href', href);
    });
  }

  function saveConditions() {
    const next = `${window.location.pathname}${noteQueryString(conditions)}${window.location.hash}`;
    if (
      next !==
      `${window.location.pathname}${window.location.search}${window.location.hash}`
    )
      window.history.replaceState(window.history.state, '', next);
    update();
  }

  function restoreConditions() {
    composing = false;
    conditions = readNoteQuery(window.location.search);
    if (search) search.value = conditions.q;
    saveConditions();
  }

  if (tools && search && entries.length > 0) {
    tools.hidden = false;
    restoreConditions();
    const applySearchInput = () => {
      conditions = normalizeNoteQuery({
        q: search.value,
        category: conditions.category,
      });
      saveConditions();
    };
    search.addEventListener('compositionstart', () => {
      composing = true;
    });
    search.addEventListener('compositionend', () => {
      composing = false;
      applySearchInput();
    });
    search.addEventListener('input', (event) => {
      if (!composing && !(event instanceof InputEvent && event.isComposing))
        applySearchInput();
    });
    filters.forEach((button) =>
      button.addEventListener('click', () => {
        conditions = normalizeNoteQuery({
          q: search.value,
          category: button.dataset.filter,
        });
        saveConditions();
      }),
    );
    document.querySelectorAll('[data-reset]').forEach((button) =>
      button.addEventListener('click', () => {
        conditions = normalizeNoteQuery();
        search.value = '';
        saveConditions();
        search.focus();
      }),
    );
    window.addEventListener('popstate', restoreConditions);
    window.addEventListener('pageshow', restoreConditions);
  }
</script>

<style>
  .clear-query {
    flex-shrink: 0;
  }
  .page-heading strong {
    font-weight: 500;
    color: var(--ink);
    font-size: 12px;
  }
  .write-record {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    margin-top: 1.25rem;
    font-size: 13px;
    text-underline-offset: 0.25em;
  }
  .local-record-scope {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .local-record-scope summary {
    padding-block: 1rem;
    cursor: pointer;
  }
  .local-record-scope p {
    max-width: 42rem;
    margin-bottom: 0.75rem;
    line-height: 1.9;
  }
</style>
