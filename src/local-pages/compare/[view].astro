---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CollectionStudy from '../../components/CollectionStudy.astro';
import FocusStudy from '../../components/FocusStudy.astro';
import relationships from '../../data/work-records.json';
import {
  collectionStudy,
  comparisonEnabled,
} from '../../lib/collection-study.mjs';
import { focusStudy } from '../../lib/focus-study.mjs';

export function getStaticPaths() {
  return comparisonEnabled(import.meta.env.LOCAL_COMPARISON)
    ? [{ params: { view: 'collection' } }, { params: { view: 'focus' } }]
    : [];
}
const isFocus = Astro.params.view === 'focus';
const works = await getCollection('works');
const notes = await getCollection('notes');
const entries = isFocus ? [] : collectionStudy(works, relationships, notes);
const focusEntries = isFocus ? focusStudy(works, relationships, notes) : [];
---

<Layout
  title={isFocus ? 'ひとつ、開く・非公開比較' : '制作の棚・非公開比較'}
  description={
    isFocus
      ? 'ひとつの制作を選び、その説明や関連する記録を読む非公開の比較案。'
      : '確認済みGitHub作品を選び、記録やコードへ進む非公開の比較案。'
  }
  section={null}
>
  {isFocus ? (
    <FocusStudy entries={focusEntries} />
  ) : (
    <CollectionStudy entries={entries} />
  )}
</Layout>
