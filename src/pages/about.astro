---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { path } from '../lib/paths';
---

<Layout title="自己紹介" description="濱谷康生の自己紹介。" section="about">
  <div class="shell inner-page simple-about">
    <h1 class="visually-hidden">自己紹介</h1>
    {site.portrait && (
      <img
        class="simple-portrait"
        src={path(site.portrait.src)}
        alt={site.portrait.alt}
        width="240"
        height="280"
      />
    )}
    {site.bio && <p>{site.bio}</p>}
    <ul>
      <li>
        <a href={site.links.github}>GitHub ↗</a>
      </li>
      {site.links.atcoder && (
        <li>
          <a href={site.links.atcoder}>AtCoder ↗</a>
        </li>
      )}
    </ul>
  </div>
</Layout>
