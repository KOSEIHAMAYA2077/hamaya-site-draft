---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedNotes, formatDate } from '../../lib/content';
import { path } from '../../lib/paths';
export async function getStaticPaths() {
  return (await publishedNotes()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  section="notes"
  type="article"
>
  <article class="shell article-page">
    <a class="back-link" href={path('notes/')}>
      ← 学び・雑記の一覧へ
    </a>
    <header class="article-heading">
      <p class="eyebrow">NOTE / {entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      <ul class="tags" aria-label="タグ">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a class="back-link bottom-back" href={path('notes/')}>
      ← 学び・雑記の一覧へ
    </a>
  </article>
</Layout>
