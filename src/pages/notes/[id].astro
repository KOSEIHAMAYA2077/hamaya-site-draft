---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import { publishedNotes, formatDate } from '../../lib/content';
import { path } from '../../lib/paths';
export async function getStaticPaths() {
  return (await publishedNotes()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  section="notes"
  type="article"
>
  <article class="shell article-page">
    <a class="back-link" href={path('notes/')} data-note-back>
      ← 雑記
    </a>
    <header class="article-heading">
      <h1>{entry.data.title}</h1>
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      <ul class="tags" aria-label="タグ">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </header>
    <Toc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <a class="back-link bottom-back" href={path('notes/')} data-note-back>
      ← 雑記
    </a>
  </article>
</Layout>

<script>
  import { notesListHref } from '../../lib/note-query.mjs';

  function restoreBackLinks() {
    const href = notesListHref(
      window.location.search,
      import.meta.env.BASE_URL,
    );
    document
      .querySelectorAll<HTMLAnchorElement>('[data-note-back]')
      .forEach((link) => {
        link.href = href;
      });
  }
  restoreBackLinks();
  window.addEventListener('popstate', restoreBackLinks);
  window.addEventListener('pageshow', restoreBackLinks);
</script>
