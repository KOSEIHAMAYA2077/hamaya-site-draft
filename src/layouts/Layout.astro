---
import { site } from '../lib/site';
import { path } from '../lib/paths';
import '../styles/global.css';
import '../styles/simple.css';
import LocalTools from '../components/LocalTools.astro';
import ReturnBridge from '../components/ReturnBridge.astro';
import ReturnEntry from '../components/ReturnEntry.astro';
import { getCollection } from 'astro:content';
import { collectionStudy } from '../lib/collection-study.mjs';
import { workroomNotes } from '../lib/workroom-notes.mjs';
import { workroomEnabled } from '../lib/build-mode.mjs';
const integrated = workroomEnabled(import.meta.env.LOCAL_WORKROOM);
interface Props {
  title?: string;
  description?: string;
  section?: 'home' | 'works' | 'notes' | 'about' | null;
  type?: 'website' | 'article';
  image?: { src: string; alt: string } | null;
  canonical?: boolean;
}
const {
  title,
  description = site.description,
  section = 'home',
  type = 'website',
  image = site.socialImage,
  canonical: includeCanonical = true,
} = Astro.props;
const resume = integrated && section === 'home';
const resumeWorks = resume ? collectionStudy(await getCollection('works')) : [];
const resumeNotes = resume ? workroomNotes(await getCollection('notes')) : [];
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical =
  Astro.site && includeCanonical && !integrated
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const shareImage =
  Astro.site && image ? new URL(path(image.src), Astro.site).href : undefined;
const links = [
  { href: '', label: '作品', key: 'works' },
  { href: integrated ? 'room/notes/' : 'notes/', label: '雑記', key: 'notes' },
  { href: 'about/', label: '自己紹介', key: 'about' },
];
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcfcfb" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:alt" content={image?.alt} />}
    <script is:inline>
      try {
        if (localStorage.getItem('archive-motion') === 'off')
          document.documentElement.dataset.motion = 'off';
      } catch {
        /* optional motion preference */
      }
    </script>
  </head>
  <body class="simple-site">
    <a class="skip-link" href="#main-content">
      本文へ移動
    </a>
    <header class="site-header shell">
      <a class="site-name" href={path()} aria-label={`${site.name} ホーム`}>
        {site.name}
      </a>
      <nav
        aria-label="主なページ"
        data-workroom-nav={integrated ? '' : undefined}
      >
        <ul>
          {links.map(({ href, label, key }) => (
            <li>
              <a
                href={path(href)}
                aria-current={
                  section === key || (section === 'home' && key === 'works')
                    ? 'page'
                    : undefined
                }
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {integrated && <ReturnBridge />}
    <footer class="site-footer shell">
      <p>{site.name}</p>
      <div>
        <a href={site.links.github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        {integrated ? (
          <details class="simple-tools">
            <summary>編集</summary>
            <a href={path('write/?kind=note')}>記事を書く</a>
            <a href={path('write/?kind=work')}>作品を追加</a>
            <a href={path('room/settings/')}>設定</a>
            {resume && (
              <ReturnEntry entries={resumeWorks} notes={resumeNotes} />
            )}
          </details>
        ) : (
          <LocalTools />
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .workroom-footer-link {
    display: inline-block;
    margin-left: 1.2rem;
    padding-block: 0.6rem;
    min-height: 44px;
  }
</style>
