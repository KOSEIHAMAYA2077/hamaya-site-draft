---
import { site } from '../lib/site';
import { path } from '../lib/paths';
import '../styles/global.css';
import LocalTools from '../components/LocalTools.astro';
interface Props {
  title?: string;
  description?: string;
  section?: 'home' | 'works' | 'notes' | 'about' | null;
  type?: 'website' | 'article';
  image?: { src: string; alt: string } | null;
  canonical?: boolean;
}
const {
  title,
  description = site.description,
  section = 'home',
  type = 'website',
  image = site.socialImage,
  canonical: includeCanonical = true,
} = Astro.props;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} — 制作と記録`;
const canonical =
  Astro.site && includeCanonical
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const shareImage =
  Astro.site && image ? new URL(path(image.src), Astro.site).href : undefined;
const links = [
  { href: '', label: 'ホーム', key: 'home' },
  { href: 'works/', label: '作品', key: 'works' },
  { href: 'notes/', label: '学び・雑記', key: 'notes' },
  { href: 'about/', label: '自己紹介', key: 'about' },
];
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f2f1eb" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:alt" content={image?.alt} />}
    <script is:inline>
      try {
        if (localStorage.getItem('archive-motion') === 'off')
          document.documentElement.dataset.motion = 'off';
      } catch {
        /* optional motion preference */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      本文へ移動
    </a>
    <header class="site-header shell">
      <a class="site-name" href={path()} aria-label={`${site.name} ホーム`}>
        {site.name}
        <span class="name-caption">制作と記録</span>
      </a>
      <nav aria-label="主なページ">
        <ul>
          {links.map(({ href, label, key }) => (
            <li>
              <a
                href={path(href)}
                aria-current={section === key ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <span class="draft-label">
        <span aria-hidden="true"></span>下書き
      </span>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <p>
        {site.name}
        <span>制作と記録を、少しずつ。</span>
      </p>
      <div>
        <a href={site.links.github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <LocalTools />
        <span class="footer-note">公開前のローカル確認用</span>
      </div>
    </footer>
  </body>
</html>
