---
import { path } from '../lib/paths';
interface Props {
  kind?: 'note' | 'work';
  label?: string;
}
const { kind = 'note', label = '下書きを書く' } = Astro.props;
---

<a
  class="local-write-link"
  href={path(`write/?kind=${kind}`)}
  data-local-tool
  hidden
>
  {label}
  <span aria-hidden="true">↗</span>
</a>

<script>
  // This is a display hint for the local writing tool, not access control.
  if (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) {
    document
      .querySelectorAll<HTMLElement>('[data-local-tool]')
      .forEach((link) => {
        link.hidden = false;
      });
  }
</script>

<style>
  .local-write-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    width: fit-content;
  }
  .local-write-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
