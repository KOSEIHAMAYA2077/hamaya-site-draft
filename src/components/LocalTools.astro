---
import { path } from '../lib/paths';
import { localBuildEnabled, workroomEnabled } from '../lib/build-mode.mjs';
interface Props {
  kind?: 'note' | 'work';
  label?: string;
}
const { kind = 'note', label = '下書きを書く' } = Astro.props;
const integrated = workroomEnabled(import.meta.env.LOCAL_WORKROOM);
const enabled = localBuildEnabled(
  {
    LOCAL_STUDIO: import.meta.env.LOCAL_STUDIO,
    LOCAL_COMPARISON: import.meta.env.LOCAL_COMPARISON,
    LOCAL_EXPERIMENTS: import.meta.env.LOCAL_EXPERIMENTS,
    LOCAL_CANDIDATES: import.meta.env.LOCAL_CANDIDATES,
    LOCAL_TIMELINE: import.meta.env.LOCAL_TIMELINE,
    LOCAL_WORKROOM: import.meta.env.LOCAL_WORKROOM,
  },
  import.meta.env.DEV,
);
---

{enabled && (
  <>
    <a
      class="local-write-link"
      href={path(`write/?kind=${kind}`)}
      data-local-tool
      hidden={!integrated}
    >
      {label}
      <span aria-hidden="true">↗</span>
    </a>

    {!integrated && (
      <a
        class="local-write-link"
        href={path('write/maker-field/')}
        target="_blank"
        rel="noopener"
        data-local-tool
        data-maker-entry
        hidden
      >
        制作ログを下書きに <span>（別タブ）</span>
      </a>
    )}

    {!integrated && import.meta.env.LOCAL_EXPERIMENTS === '1' && (
      <a
        class="local-write-link"
        href={path('compare/experiments/')}
        data-local-tool
        data-experiment-entry
        hidden
      >
        実験を見る <span aria-hidden="true">↗</span>
      </a>
    )}

    {!integrated && import.meta.env.LOCAL_CANDIDATES === '1' && (
      <a
        class="local-write-link"
        href={path('compare/candidates/')}
        data-local-tool
        data-candidate-entry
        hidden
      >
        作品候補を見る <span aria-hidden="true">↗</span>
      </a>
    )}

    {!integrated && import.meta.env.LOCAL_TIMELINE === '1' && (
      <a
        class="local-write-link"
        href={path('compare/timeline/')}
        target="_blank"
        rel="noopener"
        data-local-tool
        data-timeline-entry
        hidden
      >
        時間で見返す（別タブ）
      </a>
    )}

    <script is:inline>
      // This is a display hint for the local writing tool, not access control.
      if (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) {
        document.querySelectorAll('[data-local-tool]').forEach((link) => {
          link.hidden = false;
        });
      }
    </script>
  </>
)}

<style>
  .local-write-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    width: fit-content;
  }
  .local-write-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
