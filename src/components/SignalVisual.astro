<style>
  .signal-visual {
    --signal-accent: #b7da4e;
    display: block;
    position: relative;
    width: min(100%, 37.5rem);
    min-width: 0;
    aspect-ratio: 1;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    pointer-events: none;
    user-select: none;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: signal-arrive 1.3s cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .signal-material-metal,
  .signal-material-line,
  .signal-shadow {
    transition: opacity 0.6s ease;
  }

  .signal-material-metal,
  .signal-shadow {
    opacity: 1;
  }

  .signal-material-line {
    opacity: 0;
  }

  .signal-accent-stroke {
    stroke: var(--signal-accent);
    transition: stroke 0.6s ease;
  }

  .signal-accent-fill {
    fill: var(--signal-accent);
    transition: fill 0.6s ease;
  }

  :global(.hero-object[data-material='line']) .signal-visual {
    --signal-accent: #2c7c82;
  }

  :global(.hero-object[data-material='line']) .signal-material-metal {
    opacity: 0;
  }

  :global(.hero-object[data-material='line']) .signal-material-line {
    opacity: 1;
  }

  :global(.hero-object[data-material='line']) .signal-shadow {
    opacity: 0.52;
  }

  @keyframes signal-arrive {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.975);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  :global(html[data-motion='off']) .signal-visual,
  :global(html[data-motion='off']) .signal-visual * {
    animation: none !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-visual,
    .signal-visual * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
