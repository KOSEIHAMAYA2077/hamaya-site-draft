  .focus-form {
    transform-box: view-box;
    transform-origin: 300px 280px;
    transform: translate(var(--focus-x, 0px), var(--focus-y, 0px))
      rotate(var(--focus-turn, 0deg));
    transition: transform 220ms ease;
  }

  .focus-accent {
    transform-box: view-box;
    transform-origin: 0 0;
    transform: rotate(var(--focus-accent-turn, 0deg));
    transition: transform 220ms ease;
  }

  :global(html[data-motion='off']) .focus-form,
  :global(html[data-motion='off']) .focus-accent {
