---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
import { path } from '../lib/paths';
interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
---

<article
  class="entry-row"
  data-entry
  data-category={entry.data.category}
  data-search={`${entry.data.title} ${entry.data.description} ${entry.data.tags.join(' ')}`.toLocaleLowerCase(
    'ja',
  )}
>
  <a href={path(`room/notes/${entry.id}/`)}>
    <div class="entry-meta">
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      <span>{entry.data.category}</span>
      <span>下書き</span>
    </div>
    <div class="entry-content">
      <h2 class="entry-title">{entry.data.title}</h2>
      <p>{entry.data.description}</p>
      <ul class="tags" aria-label="タグ">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </div>
    <span class="entry-arrow" aria-hidden="true">
      →
    </span>
  </a>
</article>
