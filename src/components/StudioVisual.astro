---
interface Props {
  direction?: 'orbit' | 'paper' | 'field';
}

const { direction = 'orbit' } = Astro.props;
const id = (name: string) => `studio-${name}-${direction}`;
const paint = (name: string) => `url(#${id(name)})`;
---

<div
  class:list={['studio-visual', `studio-visual--${direction}`]}
  aria-hidden="true"
>
  <svg viewBox="0 0 520 520" fill="none" focusable="false">
    <defs>
      <radialGradient id={id('halo')}>
        <stop offset="0" stop-color="#dbe5df" stop-opacity="0.7" />
        <stop offset="0.65" stop-color="#e6eae5" stop-opacity="0.35" />
        <stop offset="1" stop-color="#f4f4ee" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={id('shadow')}>
        <stop offset="0" stop-color="#697772" stop-opacity="0.17" />
        <stop offset="1" stop-color="#697772" stop-opacity="0" />
      </radialGradient>
      <linearGradient
        id={id('silver')}
        x1="86"
        y1="96"
        x2="396"
        y2="424"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#a5aeaa" />
        <stop offset="0.17" stop-color="#fdfdf8" />
        <stop offset="0.32" stop-color="#c8ceca" />
        <stop offset="0.46" stop-color="#eef0e9" />
        <stop offset="0.58" stop-color="#8a9691" />
        <stop offset="0.66" stop-color="#e4e8e1" />
        <stop offset="0.84" stop-color="#fbfcf7" />
        <stop offset="1" stop-color="#bac3bd" />
      </linearGradient>
      <linearGradient
        id={id('glass')}
        x1="117"
        y1="90"
        x2="389"
        y2="434"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.85" />
        <stop offset="0.35" stop-color="#b7cbc2" stop-opacity="0.2" />
        <stop offset="0.64" stop-color="#fcfef9" stop-opacity="0.9" />
        <stop offset="1" stop-color="#91a69c" stop-opacity="0.28" />
      </linearGradient>
      <linearGradient
        id={id('edge')}
        x1="113"
        y1="156"
        x2="373"
        y2="365"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#64716b" stop-opacity="0.4" />
        <stop offset="0.43" stop-color="#fafdf7" />
        <stop offset="0.67" stop-color="#fcfff8" />
        <stop offset="1" stop-color="#6a7a71" stop-opacity="0.4" />
      </linearGradient>
      <radialGradient id={id('dot')} cx="35%" cy="28%" r="75%">
        <stop stop-color="#c2ddd0" />
        <stop offset="0.45" stop-color="#779c8a" />
        <stop offset="1" stop-color="#496d5e" />
      </radialGradient>
      <linearGradient
        id={id('paper')}
        x1="140"
        y1="111"
        x2="380"
        y2="413"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#fefef9" />
        <stop offset="0.72" stop-color="#f1f2eb" />
        <stop offset="1" stop-color="#e4e8e0" />
      </linearGradient>
      <pattern
        id={id('grid')}
        width="21"
        height="21"
        patternUnits="userSpaceOnUse"
      >
        <path d="M21 0H0V21" stroke="#718176" stroke-opacity="0.12" />
      </pattern>
      <clipPath id={id('sheet')}>
        <path d="M145 97L407 126Q420 127 419 142L392 413Q391 427 377 425L112 395Q98 394 100 379L128 111Q129 95 145 97Z" />
      </clipPath>
    </defs>

    <ellipse cx="264" cy="260" rx="241" ry="231" fill={paint('halo')} />

    {direction === 'orbit' && (
      <>
        <ellipse cx="270" cy="393" rx="192" ry="51" fill={paint('shadow')} />
        <g class="orbit-guide" stroke="#788b7f" stroke-opacity="0.28">
          <ellipse
            cx="261"
            cy="250"
            rx="209"
            ry="146"
            transform="rotate(-31 261 250)"
            stroke-width="0.7"
          />
          <path
            d="M101 397C143 446 272 434 371 366C468 299 489 203 432 170"
            stroke-width="0.7"
            stroke-dasharray="2 8"
          />
          <path d="M45 248H79M457 274H483" stroke-width="0.8" />
          <path d="M256 39V66M277 450V479" stroke-width="0.8" />
          <circle cx="260" cy="255" r="5" stroke-width="0.8" />
        </g>
        <g class="orbit-main">
          <ellipse
            cx="258"
            cy="256"
            rx="168"
            ry="105"
            transform="rotate(-31 258 256)"
            stroke={paint('silver')}
            stroke-width="27"
          />
          <ellipse
            cx="258"
            cy="256"
            rx="180"
            ry="118"
            transform="rotate(-31 258 256)"
            stroke={paint('edge')}
            stroke-width="1.1"
          />
          <ellipse
            cx="258"
            cy="256"
            rx="156"
            ry="93"
            transform="rotate(-31 258 256)"
            stroke="#7d8e82"
            stroke-opacity="0.32"
            stroke-width="0.8"
          />
          <path
            d="M116 300C106 271 123 233 159 196C213 141 289 111 344 124"
            stroke="#fffffa"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.83"
          />
        </g>
        <g class="orbit-glass">
          <ellipse
            cx="276"
            cy="244"
            rx="104"
            ry="176"
            transform="rotate(-27 276 244)"
            stroke={paint('glass')}
            stroke-width="15"
          />
          <ellipse
            cx="276"
            cy="244"
            rx="112"
            ry="183"
            transform="rotate(-27 276 244)"
            stroke={paint('edge')}
            stroke-width="0.8"
            opacity="0.62"
          />
          <path
            d="M213 92C269 70 346 129 387 220C417 287 421 344 397 377"
            stroke="#fffffb"
            stroke-width="1.3"
            stroke-linecap="round"
            opacity="0.78"
          />
        </g>
        <g class="orbit-satellite">
          <circle cx="126" cy="357" r="8" fill={paint('dot')} />
          <circle
            cx="126"
            cy="357"
            r="15"
            stroke="#829b8d"
            stroke-width="0.7"
            stroke-opacity="0.45"
          />
        </g>
        <circle cx="405" cy="168" r="3" fill="#738e7d" />
        <circle cx="259" cy="72" r="2" fill="#abb8ab" />
        <path
          d="M384 413C330 443 255 454 203 442"
          stroke="#899b8e"
          stroke-opacity="0.36"
          stroke-width="0.8"
          stroke-linecap="round"
        />
      </>
    )}

    {direction === 'paper' && (
      <>
        <ellipse cx="260" cy="410" rx="191" ry="45" fill={paint('shadow')} />
        <g class="paper-sheet">
          <path
            d="M158 107L419 137Q433 139 431 153L405 424Q404 437 390 436L123 406Q110 405 112 390L140 122Q141 106 158 107Z"
            fill="#cdd6cd"
            fill-opacity="0.36"
          />
          <path
            d="M145 97L407 126Q420 127 419 142L392 413Q391 427 377 425L112 395Q98 394 100 379L128 111Q129 95 145 97Z"
            fill={paint('paper')}
            stroke="#b9c3b8"
            stroke-width="0.8"
          />
          <g clip-path={paint('sheet')}>
            <path d="M84 82H434V442H84Z" fill={paint('grid')} />
            <circle
              cx="269"
              cy="263"
              r="126"
              stroke="#7e8f80"
              stroke-opacity="0.55"
              stroke-width="0.8"
            />
            <circle
              cx="269"
              cy="263"
              r="115"
              stroke="#a2b0a1"
              stroke-width="0.7"
              stroke-dasharray="1 6"
            />
            <circle cx="235" cy="261" r="82" fill={paint('glass')} />
            <circle
              cx="235"
              cy="261"
              r="82"
              stroke="#8a9c89"
              stroke-opacity="0.52"
              stroke-width="0.8"
            />
            <circle
              cx="306"
              cy="268"
              r="74"
              fill="#d8e2d5"
              fill-opacity="0.28"
              stroke="#70866f"
              stroke-opacity="0.5"
              stroke-width="0.8"
            />
            <path
              d="M154 283C168 326 214 353 260 341C306 329 332 284 319 239"
              stroke="#fdfef9"
              stroke-width="14"
              stroke-opacity="0.8"
              stroke-linecap="round"
            />
            <path
              d="M145 263H395M269 134V392"
              stroke="#6d806e"
              stroke-width="0.7"
              stroke-opacity="0.34"
            />
            <path
              d="M127 372C180 429 347 446 394 348"
              stroke="#718872"
              stroke-width="0.8"
            />
            <path
              d="M161 154L370 378"
              stroke="#80907c"
              stroke-width="0.7"
              stroke-dasharray="4 6"
              stroke-opacity="0.45"
            />
            <circle cx="269" cy="263" r="4" fill={paint('dot')} />
            <circle cx="195" cy="183" r="2.5" fill="#84967d" />
            <circle cx="355" cy="354" r="2.5" fill="#84967d" />
          </g>
        </g>
        <g class="paper-orbit">
          <ellipse
            cx="258"
            cy="269"
            rx="203"
            ry="144"
            transform="rotate(-22 258 269)"
            stroke="#83917e"
            stroke-opacity="0.4"
            stroke-width="0.7"
          />
          <path
            d="M76 288C52 239 87 177 156 135"
            stroke="#6e836d"
            stroke-width="1.2"
            stroke-linecap="round"
          />
          <circle cx="76" cy="288" r="4.5" fill={paint('dot')} />
        </g>
        <path
          d="M440 207V247M430 217H450M81 361H54M64 350V371"
          stroke="#6a7c65"
          stroke-width="0.8"
          stroke-opacity="0.55"
        />
      </>
    )}

    {direction === 'field' && (
      <>
        <ellipse cx="274" cy="423" rx="185" ry="37" fill={paint('shadow')} />
        <g class="field-contours" stroke="#879c8f" stroke-width="0.7">
          <path
            d="M87 371C35 271 122 112 259 70C336 46 410 71 455 130"
            stroke-opacity="0.28"
          />
          <path
            d="M65 340C46 218 171 78 306 70C368 66 416 93 449 139"
            stroke-opacity="0.18"
          />
          <path
            d="M100 392C191 489 393 443 448 314C477 246 449 180 408 156"
            stroke-opacity="0.43"
          />
          <path
            d="M78 405C180 512 411 451 464 306"
            stroke-opacity="0.22"
            stroke-dasharray="2 7"
          />
        </g>
        <g class="field-ribbon">
          <path
            d="M405 105C315 69 204 104 156 180C110 253 128 330 181 353C224 372 262 346 295 304C331 259 365 235 404 247C451 261 470 315 447 363C435 389 415 410 390 425L360 405C386 389 405 370 414 347C426 315 416 292 393 288C369 284 345 308 321 339C279 393 221 422 167 398C81 360 64 244 126 149C186 57 323 24 416 67L405 105Z"
            fill={paint('silver')}
            stroke="#84948a"
            stroke-opacity="0.3"
            stroke-width="0.7"
          />
          <path
            d="M407 103C317 68 206 106 159 181C113 254 130 328 183 350C225 369 263 343 295 302C331 259 366 238 403 250C448 264 465 315 444 361C432 386 413 407 390 421"
            stroke="#fffffa"
            stroke-width="2.2"
            stroke-opacity="0.81"
            stroke-linecap="round"
          />
          <path
            d="M411 71C325 34 192 68 133 151C75 236 86 349 169 390C222 416 275 388 317 335C345 299 369 278 394 284C420 290 433 320 419 352C409 376 391 394 365 409"
            stroke="#fcfff8"
            stroke-width="1.1"
            stroke-opacity="0.74"
            stroke-linecap="round"
          />
          <path
            d="M181 353C224 372 262 346 295 304C331 259 365 235 404 247"
            stroke="#708278"
            stroke-width="1.3"
            stroke-opacity="0.33"
            stroke-linecap="round"
          />
          <path
            d="M137 173C195 86 299 69 363 88"
            stroke="#fafff7"
            stroke-width="0.8"
            stroke-opacity="0.64"
            stroke-linecap="round"
          />
        </g>
        <g class="field-satellite">
          <circle cx="447" cy="313" r="5" fill={paint('dot')} />
          <circle
            cx="447"
            cy="313"
            r="12"
            stroke="#799685"
            stroke-width="0.7"
            stroke-opacity="0.38"
          />
        </g>
        <path
          d="M75 193C86 170 105 145 125 126"
          stroke="#7b9484"
          stroke-width="1.1"
          stroke-linecap="round"
          stroke-opacity="0.48"
        />
        <circle cx="73" cy="197" r="2" fill="#91a795" />
        <circle cx="337" cy="65" r="2.5" fill="#91a795" />
      </>
    )}
  </svg>
</div>

<style>
  .studio-visual {
    width: min(100%, 32.5rem);
    min-width: 0;
    aspect-ratio: 1;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    pointer-events: none;
    user-select: none;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit-main,
  .orbit-glass,
  .paper-sheet,
  .field-ribbon {
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: studio-entry 1.3s cubic-bezier(0.2, 0.7, 0.25, 1) both;
  }
  .orbit-glass {
    animation-delay: 0.12s;
  }
  .orbit-satellite,
  .field-satellite {
    animation: studio-entry 1.1s ease-out both;
  }
  @keyframes studio-entry {
    from {
      transform: translateY(8px) rotate(-1.2deg);
      opacity: 0.5;
    }
    to {
      transform: translateY(0) rotate(0);
      opacity: 1;
    }
  }
  :global(html[data-motion='off']) .studio-visual * {
    animation: none !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-visual * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
