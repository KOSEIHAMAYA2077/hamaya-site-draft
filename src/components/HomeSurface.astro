---
import { publishedWorks, publishedNotes } from '../lib/content';
import { path } from '../lib/paths';
import EmptyState from './EmptyState.astro';
import EntryRow from './EntryRow.astro';
import StudioVisual from './StudioVisual.astro';
import SignalVisual from './SignalVisual.astro';
import LocalTools from './LocalTools.astro';
import { site } from '../lib/site';
interface Props {
  direction?: 'orbit' | 'paper' | 'field' | 'signal';
  study?: boolean;
  previewNotice?: boolean;
}
const {
  direction = 'orbit',
  study = false,
  previewNotice = false,
} = Astro.props;
const works = await publishedWorks();
const notes = await publishedNotes();
const recent = [...works, ...notes]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);
---

<div class:list={['home-surface', `direction-${direction}`]}>
  {study && (
    <div class="study-banner shell">
      <a href={path('directions/')}>← 方向性の比較へ</a>
      <span>方向性 {direction.toUpperCase()}</span>
    </div>
  )}
  {previewNotice && (
    <p class="content-preview-banner shell">
      表示の比較用です。公開リポジトリの資料を仮配置しています。本人の掲載判断を待っています。
    </p>
  )}
  <section class="hero shell" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="small-orbit" aria-hidden="true"></span>PERSONAL ARCHIVE
        <span class="eyebrow-index">01 / 04</span>
      </p>
      <h1 id="home-title">
        <span>つくったものと、</span>
        <span>考えたこと。</span>
      </h1>
      <p class="hero-description">
        制作物、学んだこと、日々の雑記。
        <br />
        あとで振り返れるように、ここに残します。
      </p>
      <div class="hero-actions">
        <a class="round-link" href={path('works/')}>
          <span>作品の一覧へ</span>
          <span class="round-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <LocalTools />
      </div>
      <p class="hero-footnote">
        <span aria-hidden="true">＋</span>少しずつ、書き足していく場所。
      </p>
    </div>
    <div class="hero-object" data-reactive-visual data-material="metal">
      {direction === 'signal' ? (
        <SignalVisual />
      ) : (
        <StudioVisual direction={direction} />
      )}
      {direction === 'signal' && (
        <div
          class="material-picker"
          role="group"
          aria-label="立体の質感"
          data-material-picker
          hidden
        >
          <span>質感を切り替える</span>
          <button
            type="button"
            data-material-choice="metal"
            aria-pressed="true"
          >
            銀色
          </button>
          <button
            type="button"
            data-material-choice="line"
            aria-pressed="false"
          >
            光の線
          </button>
          <span
            class="sr-only"
            role="status"
            aria-live="polite"
            data-material-status
          >
            銀色の質感です。
          </span>
        </div>
      )}
      <p class="visual-caption">
        <span>IDEAS → MAKING → NOTES</span>
        <button
          class="motion-toggle"
          type="button"
          data-motion-toggle
          aria-pressed="false"
          hidden
        >
          動きを止める
        </button>
      </p>
    </div>
  </section>
  <section class="archive-paths shell" aria-labelledby="paths-title">
    <div class="section-lead">
      <p class="eyebrow">EXPLORE</p>
      <h2 id="paths-title">ここに置くもの</h2>
      <p>つくることと、考えること。その途中も。</p>
    </div>
    <div class="paths-list">
      <a class="archive-path" href={path('works/')}>
        <span class="path-number">01</span>
        <div>
          <h3>作品</h3>
          <p>つくったもの。試しているもの。</p>
        </div>
        <span class="path-count">
          {works.length.toString().padStart(2, '0')}件
        </span>
        <span class="path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a class="archive-path" href={path('notes/')}>
        <span class="path-number">02</span>
        <div>
          <h3>学び・雑記</h3>
          <p>わかったこと。まだ考えていること。</p>
        </div>
        <span class="path-count">
          {notes.length.toString().padStart(2, '0')}件
        </span>
        <span class="path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a class="archive-path" href={path('about/')}>
        <span class="path-number">03</span>
        <div>
          <h3>自己紹介</h3>
          <p>この場所をつくっている人について。</p>
        </div>
        <span class="path-count">{site.bio ? '紹介' : '未入力'}</span>
        <span class="path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
  </section>
  <section class="recent-section shell" aria-labelledby="recent-title">
    <div class="section-top">
      <div>
        <p class="eyebrow">RECENT</p>
        <h2 id="recent-title">最近の記録</h2>
      </div>
      <a class="text-link" href={path('notes/')}>
        学び・雑記の一覧へ <span aria-hidden="true">↗</span>
      </a>
    </div>
    {recent.length ? (
      <div class="entry-list">
        {recent.map((entry) => (
          <EntryRow entry={entry} level={3} />
        ))}
      </div>
    ) : (
      <EmptyState type="notes" level={3} />
    )}
  </section>
  <section class="about-strip shell">
    <span class="eyebrow">ABOUT THIS PLACE</span>
    <p>
      まだ途中のものも、
      <br />
      考え直したことも残しておきたい。
    </p>
    <a class="round-link" href={path('about/')}>
      <span>自己紹介へ</span>
      <span class="round-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  </section>
</div>

<script>
  const visual = document.querySelector<HTMLElement>('[data-reactive-visual]');
  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-motion-toggle]',
  );
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const materials = document.querySelector<HTMLElement>(
    '[data-material-picker]',
  );
  if (visual && materials) {
    materials.hidden = false;
    const choices = [
      ...materials.querySelectorAll<HTMLButtonElement>(
        '[data-material-choice]',
      ),
    ];
    choices.forEach((choice) =>
      choice.addEventListener('click', () => {
        const selected = choice.dataset.materialChoice;
        if (selected !== 'metal' && selected !== 'line') return;
        visual.dataset.material = selected;
        choices.forEach((button) =>
          button.setAttribute('aria-pressed', String(button === choice)),
        );
        const status = materials.querySelector<HTMLElement>(
          '[data-material-status]',
        );
        if (status)
          status.textContent =
            selected === 'metal' ? '銀色の質感です。' : '光の線の質感です。';
      }),
    );
  }
  const pointer = window.matchMedia('(pointer: fine)');
  const scene = visual?.querySelector<SVGSVGElement>(
    '.studio-visual, .signal-visual',
  );
  let paused = false;
  try {
    paused = localStorage.getItem('archive-motion') === 'off';
  } catch {
    /* preference storage is optional */
  }
  let queued = false;
  let inView = true;
  let controlsHovered = false;
  let pointerX = 0;
  let pointerY = 0;
  function inspectingMaterial() {
    return (
      controlsHovered || Boolean(materials?.contains(document.activeElement))
    );
  }
  function syncPoseHold() {
    if (!visual || !scene) return;
    const hold = inspectingMaterial() && !paused && !reduced.matches;
    if (hold && !visual.hasAttribute('data-pose-fixed')) {
      visual.style.setProperty(
        '--fixed-pose',
        getComputedStyle(scene).transform,
      );
      visual.setAttribute('data-pose-fixed', '');
    } else if (!hold) {
      visual.removeAttribute('data-pose-fixed');
      visual.style.removeProperty('--fixed-pose');
      queue();
    }
  }
  function paint() {
    queued = false;
    if (!visual || paused || reduced.matches || !inView || inspectingMaterial())
      return;
    const bounds = visual.getBoundingClientRect();
    const progress = Math.max(
      -1,
      Math.min(
        1,
        (innerHeight / 2 - bounds.top - bounds.height / 2) / innerHeight,
      ),
    );
    visual.style.setProperty(
      '--visual-x',
      `${pointerX * (visual.closest('.direction-signal') ? 10 : 6)}px`,
    );
    visual.style.setProperty(
      '--visual-y',
      `${progress * (visual.closest('.direction-signal') ? 30 : 14) + pointerY * 5}px`,
    );
    visual.style.setProperty(
      '--visual-turn',
      `${pointerX * (visual.closest('.direction-signal') ? 1.7 : 0.6) + progress * 0.5}deg`,
    );
  }
  function queue() {
    if (
      !queued &&
      visual &&
      !paused &&
      !reduced.matches &&
      inView &&
      !inspectingMaterial()
    ) {
      queued = true;
      requestAnimationFrame(paint);
    }
  }
  function sync() {
    const off = paused || reduced.matches;
    document.documentElement.dataset.motion = off ? 'off' : 'on';
    if (toggle) {
      toggle.hidden = reduced.matches;
      toggle.textContent = paused ? '動きを再開' : '動きを止める';
      toggle.setAttribute('aria-pressed', String(paused));
    }
    if (off && visual) {
      ['--visual-x', '--visual-y', '--visual-turn'].forEach((key) =>
        visual.style.removeProperty(key),
      );
    } else queue();
    syncPoseHold();
  }
  if (visual && toggle) {
    sync();
    toggle.addEventListener('click', () => {
      paused = !paused;
      try {
        localStorage.setItem('archive-motion', paused ? 'off' : 'on');
      } catch {
        /* no storage needed for this page */
      }
      sync();
    });
    visual.addEventListener('pointermove', (event) => {
      if (!pointer.matches || event.pointerType !== 'mouse') return;
      if ((event.target as Element).closest('button, .material-picker')) return;
      const bounds = visual.getBoundingClientRect();
      pointerX = Math.max(
        -1,
        Math.min(1, ((event.clientX - bounds.left) / bounds.width) * 2 - 1),
      );
      pointerY = Math.max(
        -1,
        Math.min(1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1),
      );
      queue();
    });
    visual.addEventListener('pointerleave', () => {
      pointerX = 0;
      pointerY = 0;
      queue();
    });
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    reduced.addEventListener('change', sync);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        if (inView) queue();
      });
      observer.observe(visual);
    }
    if (materials) {
      materials.addEventListener('pointerenter', () => {
        controlsHovered = true;
        syncPoseHold();
      });
      materials.addEventListener('pointerleave', () => {
        controlsHovered = false;
        syncPoseHold();
      });
      materials.addEventListener('focusin', syncPoseHold);
      materials.addEventListener('focusout', () =>
        queueMicrotask(syncPoseHold),
      );
    }
  }
</script>

<style>
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    margin-top: 2.1rem;
  }
  .hero-actions :global(.round-link) {
    margin-top: 0 !important;
  }
  @media (max-width: 760px) {
    .hero-actions {
      margin-top: 1.5rem;
    }
  }
  .hero-object[data-pose-fixed] > :global(.studio-visual),
  .hero-object[data-pose-fixed] > :global(.signal-visual) {
    transform: var(--fixed-pose, none) !important;
    transition: none !important;
  }
</style>
