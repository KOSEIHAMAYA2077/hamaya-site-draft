{
  "name": "hamaya-site-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "build:local": "LOCAL_STUDIO=1 astro build",
    "build:compare": "LOCAL_COMPARISON=1 astro build",
    "build:experiments": "LOCAL_EXPERIMENTS=1 astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "lint": "prettier --check . && astro check",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs",
    "new": "node scripts/new-entry.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "entities": "4.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
